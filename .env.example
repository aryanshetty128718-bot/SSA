# Application Settings
ENVIRONMENT=development
DEBUG=True
APP_NAME="Smart Shopping Assistant"
API_V1_PREFIX=/api/v1
SECRET_KEY=your-secure-secret-key-min-32-chars-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin and Demo User Credentials (Required for seed_data.py)
ADMIN_EMAIL=admin@your-domain.local
ADMIN_PASSWORD=your-secure-admin-password-min-8-chars-with-digit
DEMO_EMAIL=demo@your-domain.local
DEMO_PASSWORD=your-secure-demo-password-min-8-chars-with-digit

# Database Configuration
# Default to SQLite local fallback for instant zero-config standalone development
DATABASE_URL=sqlite:///./smart_shopping.db
# For PostgreSQL via Docker:
# DATABASE_URL=postgresql://ssa_user:ssa_password@localhost:5432/smart_shopping_db

# External API
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
OPEN_FOOD_FACTS_TIMEOUT_SECONDS=8.0
USER_AGENT="SmartShoppingAssistant/1.0 (MCA Project Academic Research)"

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
